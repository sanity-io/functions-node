{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "@aws-lite/dynamodb-types", "@aws-lite/lambda-types", "@aws-lite/sns-types", "@aws-lite/sqs-types"],
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    // strict, esModuleInterop, etc. are on by default as of TS6
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "include": ["src"]
}
